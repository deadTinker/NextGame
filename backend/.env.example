# PostgreSQL connection string. For local development, use your local PostgreSQL database.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nextquest

# Generate a long random secret; do not commit your real .env file.
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters

# Frontend origin. Vite commonly runs on port 5173.
CLIENT_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development
